# Copy this file to .env and fill in your own values. NEVER commit .env.
PORT=3000
NODE_ENV=development

# --- Option A: individual settings (XAMPP: user root, EMPTY password by default) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=batloung_farm
DB_CONNECTION_LIMIT=10

# --- Option B: one connection string (TiDB Cloud, Aiven, Railway, ...) ---
# If DATABASE_URL is set it is used instead of the DB_* values above.
# DATABASE_URL=mysql://user:password@host:3306/dbname
# (special characters in the password must be URL-encoded, e.g. @ becomes %40)

# Set to true when the hosted MySQL requires TLS (Aiven, PlanetScale ...)
DB_SSL=false

# Set to true on hosts where you cannot run CREATE DATABASE (db already exists)
SKIP_CREATE_DB=false
